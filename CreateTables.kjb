    </entry>
    <entry>
      <name>create PSM</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DO $$
BEGIN
IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'rec_user_type') THEN
CREATE TYPE rec_user_type AS
(
id integer,
message text
);
END IF;
END $$;

create or replace
function public.inserta_dimgeolocation(
aDatum text,
aLat double precision,
aLon double precision,
aCounty text,
aState text,
aCountry text)
returns rec_user_type
language 'plpgsql'
as $BODY$
declare
aStationID integer;

aCountryID integer;

aStateID integer;

aCountyID integer;

rec rec_user_type;

begin
select
	id
into
	aCountryID
from
	geolocation3
where
	countryname = aCountry;

if not found then
insert
	into
	geolocation3 (countryname)
values (aCountry) returning id
into
	aCountryID;
end if;

select
	id
into
	aStateID
from
	geolocation2
where
	statename = aState
	and countryfk = aCountryID;

if not found then
insert
	into
	geolocation2 (statename,
	countryfk)
values (aState,
aCountryID) returning id
into
	aStateID;
end if;

select
	id
into
	aCountyID
from
	geolocation1
where
	countyname = aCounty
	and statefk = aStateID;

if not found then
insert
	into
	geolocation1 (countyname,
	statefk)
values (aCounty,
aStateID) returning id
into
	aCountyID;
end if;

select
	id
into
	aStationID
from
	geolocation0
where
	lat = aLat
	and lon = aLon
	and datum = aDatum;

if not found then
insert
	into
	geolocation0 (lat,
	lon,
	datum,
	countyfk)
values (aLat,
aLon,
aDatum,
aCountyID) returning id
into
	aStationID;
end if;

rec.id = aStationID;

rec.message = null;

return rec;

exception
when others then
rec.id = null;

rec.message = sqlerrm;

return rec;
end
$BODY$;</sql>
