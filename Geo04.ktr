        <class_type>TRANSFORM_CLASS</class_type>
        <class_name>Processor</class_name>
        <class_source>import gov.nasa.worldwind.WorldWind;
import gov.nasa.worldwind.geom.Position;   
import gov.nasa.worldwind.geom.coords.DatumTransformation;

private int latIndex;
private int lonIndex;
private int datumsourceIndex;
private int datumtargetIndex;

// overriding (if neccesary)
public boolean init(StepMetaInterface stepMetaInterface, StepDataInterface stepDataInterface) {
 if (super.init(stepMetaInterface, stepDataInterface)) {
 WorldWind.setOfflineMode(true);
 return true;

 }
 return false;
}


public boolean processRow(StepMetaInterface smi, StepDataInterface sdi) throws KettleException
{
    // First, get a row from the default input hop
	Object[] r = getRow();
	


    // If the row object is null, we are done processing.
	// The method will block until a row is made available.
	if (r == null) {
		setOutputDone();
		return false;
	}

 
	// Let's look up parameters only once for performance reason.
	//
	if (first) {
		first= false;
		checkParameters();
     }


	// data.inputRowMeta  == getInputRowMeta()
	//logBasic(String.format("llega metainfo= %s",getInputRowMeta()   ) );
	//logBasic(String.format("llega metainfo size= %d",getInputRowMeta().size()   ) );

    // It is always safest to call createOutputRow() to ensure that your output row's Object[] is large
    // enough to handle any new fields you are creating in this step.
	//
    Object[] outputRowData = createOutputRow(r, data.outputRowMeta.size());
	//logBasic(String.format("sale metainfo= %s",data.outputRowMeta   ) );


	Double lat = Double.valueOf(getInputRowMeta().getString(r, latIndex));
	Double lon = Double.valueOf(getInputRowMeta().getString(r, lonIndex));

	String datumsource = getInputRowMeta().getString(r, datumsourceIndex);
	String datumtarget = getInputRowMeta().getString(r, datumtargetIndex);

    logBasic(String.format("llega lat=%g lon=%g expresada en %s y se busca convertirla a %s",
                lat, lon, datumsource, datumtarget   ) );


	// cual es el ultimo indice usado? asi colocamos la nueva info a continuacion
	int outputIndex = getInputRowMeta().size();

	// Set the value in the output field
	//
	Double[] transf = getNewCoordinates(lat, lon,  datumsource, datumtarget);
    //logBasic(String.format("voy a retornar newlat= %g  newlon=%g expresado en %s ",
    //          transf[0], transf[1], datumtarget));
  
    outputRowData[outputIndex++]=transf[0];
    outputRowData[outputIndex++]=transf[1];

    // putRow will send the row on to the default output hop.
    putRow(data.outputRowMeta, outputRowData);



 
	return true;
}




private void checkParameters() throws KettleException {
	    latIndex = getInputRowMeta().indexOfValue("latitude");
        logBasic(String.format("latitude encontrado en posicion %d", latIndex));
        if (latIndex&lt;0) 
         	throw new KettleException("lat field not found in the input row.");
        
		lonIndex = getInputRowMeta().indexOfValue("longitude");
        logBasic(String.format("longitude encontrado en posicion %d", lonIndex));
		if (lonIndex&lt;0) 
         	throw new KettleException("lon field not found in the input row.");

		datumsourceIndex = getInputRowMeta().indexOfValue("datumsource");
		logBasic(String.format("datumesource encontrado en posicion %d", datumsourceIndex));
        if (datumsourceIndex&lt;0) 
         	throw new KettleException("datumsource field not found in the input row.");

		datumtargetIndex = getInputRowMeta().indexOfValue("datumtarget");
		logBasic(String.format("datumtarget encontrado en posicion %d", datumtargetIndex));
        if (datumtargetIndex&lt;0) 
         	throw new KettleException("datumtarget field not found in the input row.");
}


   public Double[] getNewCoordinates(double lat, double lon, String datumsource, String datumtarget )
    {	
		Double[] rta= new Double[2];
    		if (check(datumsource) &amp;&amp; check(datumtarget))
    		{
    			rta[0] = getLatAuxi(lat, lon, datumsource, datumtarget);
    			rta[1] = getLonAuxi(lat, lon, datumsource, datumtarget);		
    			if (rta[0] != null &amp;&amp; rta[1] != null)
    				return rta;
    		}	
    		throw new RuntimeException(String.format("Cannot convert lat=%g, lon=%g dat=%s to %s",
        					lat, lon, datumsource, datumtarget));
    		
    }
    

    public boolean check(String datum)
    {
    	return	datum != null &amp;&amp;
    			("NAD27".equalsIgnoreCase(datum) ||
    			 "NAD83".equalsIgnoreCase(datum) ||
    			 "WGS84".equalsIgnoreCase(datum) 
				);
			
    }

	public Double getLatAuxi(double lat, double lon, String datumsource, String datumtarget)
	{
	//	WorldWind.setOfflineMode(true);
		try
		{
			if ("NAD27".equalsIgnoreCase(datumsource))
			{
				if ("NAD83".equalsIgnoreCase(datumtarget) || "WGS84".equalsIgnoreCase(datumtarget) )
					return DatumTransformation.convertNad27toWGS84(Position.fromDegrees(lat, lon)).getLatitude().degrees;
				if ("NAD27".equalsIgnoreCase(datumtarget) )
					return Position.fromDegrees(lat, lon).getLatitude().degrees;
			}
		
			
			if ("NAD83".equalsIgnoreCase(datumsource) || "WGS84".equalsIgnoreCase(datumsource) )
			{
				if ("NAD27".equalsIgnoreCase(datumtarget) )
					return DatumTransformation.convertWGS84toNad27(Position.fromDegrees(lat, lon)).getLatitude().degrees;
				if ("NAD83".equalsIgnoreCase(datumtarget) || "WGS84".equalsIgnoreCase(datumtarget) )
					return Position.fromDegrees(lat, lon).getLatitude().degrees;
			}
		}
		catch(Exception e)
		{}

		return null;
		
	}
		
 
	public Double getLonAuxi(double lat, double lon, String datumsource, String datumtarget)
	{
	//	WorldWind.setOfflineMode(true);
		try
		{
			if ("NAD27".equalsIgnoreCase(datumsource))
			{
				if ("NAD83".equalsIgnoreCase(datumtarget) || "WGS84".equalsIgnoreCase(datumtarget) )
					return DatumTransformation.convertNad27toWGS84(Position.fromDegrees(lat, lon)).getLongitude().degrees;
				if ("NAD27".equalsIgnoreCase(datumtarget) )
					return Position.fromDegrees(lat, lon).getLongitude().degrees;
			}
		
			
			if ("NAD83".equalsIgnoreCase(datumsource) || "WGS84".equalsIgnoreCase(datumsource) )
			{
				if ("NAD27".equalsIgnoreCase(datumtarget) )
					return DatumTransformation.convertWGS84toNad27(Position.fromDegrees(lat, lon)).getLongitude().degrees;
				if ("NAD83".equalsIgnoreCase(datumtarget) || "WGS84".equalsIgnoreCase(datumtarget) )
					return Position.fromDegrees(lat, lon).getLongitude().degrees;
			}
		}
		catch(Exception e)
		{}

		return null;
	}

