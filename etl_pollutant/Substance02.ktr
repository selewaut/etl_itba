  <step>
    <name>check source</name>
    <type>Janino</type>
    <description>Null-safe source guard: sets source_reason to a diagnostic or null when the row is usable</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>source_reason</field_name>
      <formula_string>(name == null || name.trim().isEmpty()) ? "null or empty name" : ((unit == null || unit.trim().isEmpty()) ? "null or empty unit" : null)</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
