    </partitioning>
    <send_true_to>normalize unit</send_true_to>
    <send_false_to>header rejects</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>name</leftvalue>
        <function>&lt;></function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Parameter Name</text>
          <length>-1</length>
