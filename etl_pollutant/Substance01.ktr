    </GUI>
  </step>
  <step>
    <name>normalize name</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>name</field_name>
      <formula_string>name == null ? name : ("carbon monoxide".equalsIgnoreCase(name.replaceAll("\\s+", " ").trim()) || "co".equalsIgnoreCase(name.replaceAll("\\s+", " ").trim()) || "carbno monoxide".equalsIgnoreCase(name.replaceAll("\\s+", " ").trim()) || "cabron monoxide".equalsIgnoreCase(name.replaceAll("\\s+", " ").trim()) ? "Carbon monoxide" : name.replaceAll("\\s+", " ").trim())</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field>name</replace_field>
    </formula>
