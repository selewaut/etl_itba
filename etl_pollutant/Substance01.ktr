    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>unit</field_name>
      <formula_string>unit == null ? unit : ("parts per million".equalsIgnoreCase(unit.replaceAll("\\s+", " ").trim()) || "ppm".equalsIgnoreCase(unit.replaceAll("\\s+", " ").trim()) ? "PPM" : unit.replaceAll("\\s+", " ").trim())</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field>unit</replace_field>
