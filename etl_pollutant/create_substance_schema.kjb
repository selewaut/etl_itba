    <entry>
      <name>SQL CREATE TABLES</name>
      <description>Create Substance + auxiliaries from external SQL file</description>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE TABLE IF NOT EXISTS Substance (
    SubstanceID serial NOT NULL PRIMARY KEY,
    Name        text NOT NULL UNIQUE,
    Unit        text NOT NULL,
    UNIQUE (Name)
);

-- guarda las corridas correctas
CREATE TABLE IF NOT EXISTS etl_run (
    etl_run_id  bigserial PRIMARY KEY,
    job_name    text NOT NULL,
    started_at  timestamptz NOT NULL DEFAULT now(),
    finished_at timestamptz,
    status      text NOT NULL DEFAULT 'RUNNING'
);

-- guarda las corridas rechazadas
CREATE TABLE IF NOT EXISTS etl_rejects (
    etl_run_id  bigint NOT NULL REFERENCES etl_run (etl_run_id),
    stage       text NOT NULL,
    myid        integer,
    raw_payload jsonb,
    reason      text NOT NULL,
    ts          timestamptz NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_etl_rejects_run ON etl_rejects (etl_run_id);

INSERT INTO Substance (Name, Unit) VALUES ('Carbon monoxide', 'PPM') ON CONFLICT (Name) DO NOTHING;
</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename>pollutant_schema.sql</sqlfilename>
      <sendOneStatement>F</sendOneStatement>
      <connection>OLAP</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>816</xloc>
      <yloc>144</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>create PSM</name>
      <description>Create inserta_substance upsert function</description>
      <type>SQL</type>
      <attributes/>
      <sql>DO $$
BEGIN
IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'rec_user_type') THEN
CREATE TYPE rec_user_type AS
(
id integer,
message text
);
END IF;
END $$;

create or replace
function public.inserta_substance(
aName text,
aUnit text)
returns rec_user_type
language 'plpgsql'
as $BODY$
declare
aSubstanceID integer;

rec rec_user_type;

begin
select
	SubstanceID
into
	aSubstanceID
from
	Substance
where
	Name = aName;

if not found then
insert
	into
	Substance (Name,
	Unit)
values (aName,
aUnit) returning SubstanceID
into
	aSubstanceID;
end if;

rec.id = aSubstanceID;

rec.message = null;

return rec;

exception
when others then
rec.id = null;

rec.message = format('name=%s unit=%s: %s', aName, aUnit, sqlerrm);

return rec;
end
$BODY$;</sql>
